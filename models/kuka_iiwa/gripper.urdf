<?xml version="1.0"?>
<robot name="simple_parallel_gripper">
  <link name="gripper_base">
    <visual>
      <geometry>
        <box size="0.08 0.08 0.04"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.08 0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <link name="left_finger">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.08"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.06 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="left_finger_pad">
    <visual>
      <geometry>
        <box size="0.01 0.05 0.07"/>
      </geometry>
      <material name="rubber">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.05 0.07"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <link name="right_finger">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.08"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.06 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>

  <link name="right_finger_pad">
    <visual>
      <geometry>
        <box size="0.01 0.05 0.07"/>
      </geometry>
      <material name="rubber">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.01 0.05 0.07"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="left_finger"/>
    <origin xyz="0.0 0.04 0.0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="50" lower="0.0" upper="0.04" velocity="0.1"/>
    <dynamics damping="10.0" friction="1.0"/>
  </joint>

  <joint name="left_finger_pad_joint" type="fixed">
    <parent link="left_finger"/>
    <child link="left_finger_pad"/>
    <origin xyz="0.015 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="gripper_base"/>
    <child link="right_finger"/>
    <origin xyz="0.0 -0.04 0.0" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit effort="50" lower="0.0" upper="0.04" velocity="0.1"/>
    <dynamics damping="10.0" friction="1.0"/>
  </joint>

  <joint name="right_finger_pad_joint" type="fixed">
    <parent link="right_finger"/>
    <child link="right_finger_pad"/>
    <origin xyz="-0.015 0 0" rpy="0 0 0"/>
  </joint>
</robot>
